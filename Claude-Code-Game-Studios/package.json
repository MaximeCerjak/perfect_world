{
  "name": "ressources-egales",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "test": "npm run test:engine && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:single && playwright test",
    "smoke": "npm run build:single && playwright test --grep @boot",
    "demo": "rm -rf data/demo && node tools/demo-si-absente.mjs",
    "predev": "node tools/demo-si-absente.mjs",
    "prebuild": "node tools/demo-si-absente.mjs",
    "prebuild:single": "node tools/demo-si-absente.mjs",
    "test:engine": "python3 -m unittest discover -s tests/engine",
    "serve": "PYTHONPATH=server python3 -m ressources_egales servir"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  }
}
